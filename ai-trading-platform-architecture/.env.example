# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/trading_assistant

# --- Telegram --------------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Random secret shared with Telegram's setWebhook; verified in constant time
# on every incoming update. Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Numeric Telegram user IDs allowed to run owner commands (comma separated).
# Get yours from @userinfobot. Non-owners receive "unknown command".
OWNER_TELEGRAM_IDS=

# Shown by /الدعم
SUPPORT_CONTACT=@your_support_handle

# --- Market data -----------------------------------------------------------
# Failover order. Public endpoints — no API keys required.
MARKET_DATA_SOURCES=binance,bybit,okx

# Allow the deterministic simulator as a fallback source.
# MUST stay false in production: customers must never receive signals
# derived from synthetic prices.
ALLOW_SIMULATED_DATA=false

# --- Scheduled jobs --------------------------------------------------------
# Bearer secret for POST /api/cron/{job}. Generate: openssl rand -hex 32
CRON_SECRET=

# Engine tuning (optional — calibrated defaults apply when unset).
# minConfluence is intentionally NOT configurable here: it is backed by a
# measured study (npm run calibrate) and must not be lowered casually.
MAX_SIGNALS_PER_DAY=6
SIGNAL_COOLDOWN_MINUTES=240
PUBLISH_REFUSALS=false

# --- Auto-Trading ----------------------------------------------------------
# Trading mode: off | paper | live
#   off   = signals only (original behaviour, no orders placed)
#   paper = simulated execution for testing without real money
#   live  = real exchange execution with real money
TRADING_MODE=off

# Paper trading initial equity (used when TRADING_MODE=paper)
PAPER_TRADING_EQUITY=10000

# Encryption key for storing exchange API keys (generate: openssl rand -hex 32)
# Required for TRADING_MODE=live
TRADING_ENCRYPTION_KEY=

# --- Exchange API (for live trading) ---------------------------------------
# Binance Futures
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Auto-trading risk defaults (overridable per account) ------------------
# Risk per trade as % of equity
TRADING_RISK_PER_TRADE_PCT=1
# Max daily loss % before trading halts
TRADING_MAX_DAILY_LOSS_PCT=5
# Max drawdown % from peak before trading halts
TRADING_MAX_DRAWDOWN_PCT=20
# Max concurrent positions
TRADING_MAX_CONCURRENT_POSITIONS=3
# Default leverage for futures
TRADING_DEFAULT_LEVERAGE=3
# Max leverage allowed
TRADING_MAX_LEVERAGE=10
# Position sizing method: risk_based | fixed_fractional | kelly | fixed_ratio
TRADING_SIZING_METHOD=risk_based
# Half-Kelly fraction (only for sizing_method=kelly)
TRADING_KELLY_FRACTION=0.5
# Enable trailing stops after TP1
TRADING_TRAIL_STOP=true
# Move stop to breakeven after TP1
TRADING_MOVE_STOP_TO_BREAKEVEN=true
# Scale out at TP1 (close partial position)
TRADING_SCALE_OUT_AT_TP1=false
# Fraction to close at TP1 (if scale out enabled)
TRADING_SCALE_OUT_TP1_FRACTION=0.5

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
